#include <math.h>

#define TRIGPIN 14
#define ECHOPIN 15

int y = 0;
int a = 0, b = 0, c = 0;
int q = 0;
int fq = 0;
int threshold = 1;
// ★ 删掉了原来的 u：它在 STOP() 里自增又清零，但 ting() 是无条件调用的，
//   这个计数从来没起到"保持停车"的作用，纯属死逻辑。

bool heiLocked = false;
unsigned long heiStart = 0;

// ★★★ 黑线（hei）触发策略
#define HEI_DURATION    1000UL   // 黑线直行时长上限（原 3000，正是那 3 秒延迟的来源）
#define HEI_DEBOUNCE_MS 50       // 111 必须连续保持这么久，才认定为真黑线
#define HEI_MIN_MS      150      // hei 最短执行时间，避免刚进就退
#define HEI_EARLY_EXIT  1        // 黑线从探头下消失就提前收工（0 = 关，死等满 HEI_DURATION）

bool          heiArmed   = true;   // 允许触发黑线；离开 111 后自动重新武装
bool          q111Active = false;  // 当前是否连续处于 111
unsigned long q111Start  = 0;      // 本次连续 111 的起点

bool zhiLocked = false;

// ★ 超声波状态锁：hei(y) 动作执行期间上锁，动作完成后解锁
bool ultraLocked = false;

// ★★★ 超声波停车锁（本次修复的核心）
//   老代码：STOP() 排在 move_tai() 后面，只是在末尾把四个引脚擦一遍，
//   可下一轮 loop 开头 move_tai() 又立刻把 PWM 拉满 —— 电机只是被"闪"了
//   几十微秒，平均输出仍然接近全速，肉眼看就是"压根没停"。
//   正确做法：停车做成一把锁，锁着的时候 move_tai() 一律不许驱动电机。
bool stopLocked = false;

// ★ 超声波停车阈值（厘米）：距离 <= STOP_MAX 即停车
//   老代码用 [13, 17] 这个"带"当判据，车稍微快一点就会从 >17 一步跨到 <13，
//   掉出窗口后就再也不停了（越近越危险，反而放行）。近处只会更危险，所以只留上界。
#define STOP_MAX 17

// ★ 超声波停车去抖：连续 N 次测不到障碍才放行，避免一个丢包就让车往前窜
#define STOP_CLEAR_COUNT 2

// ★★★ 响应速度参数
//   ECHO_TIMEOUT_US 是 pulseIn 的总超时，它包含"等 ECHO 从低变高"这段
//   模块响应延迟（几百 us）。1200us 扣掉延迟只剩 ~900us，只够测到 ~15cm，
//   17cm 附近经常直接被判成超时 → distance=999 → 当成"无障碍"直接放行。
#define ECHO_TIMEOUT_US   2000UL   // 放宽后可测约 30cm，仍稳稳盖住停车区
#define ULTRA_INTERVAL_US 20000UL  // 每 20ms 测一次超声波（原 10ms）
#define ZHI_TIMEOUT_MS    400      // 对正最长持续时间（原 1200），超时自动解锁（0 = 关闭）

// ★ 非阻塞超声波状态机
volatile unsigned long echoStart = 0;
volatile float distance = 999;
int ultraState = 0;  // 0=空闲 1=等待回响
unsigned long trigTime = 0;

unsigned long zhiStart = 0;   // ★ 对正开始时刻，用于超时兜底

void qian();
void hou();
void L();
void R();
void hei(int i);
void zhi();
void ting();

void du()
{
    if      (b == 1 && a == 0 && c == 0)  q = 10;
    else if (a == 0 && b == 0 && c == 0)  q = fq;
    else if (a == 1 && b == 0 && c == 0)  q = 100;
    else if (a == 0 && b == 0 && c == 1)  q = 1;
    else if (a == 0 && b == 1 && c == 1)  q = 1;
    else if (a == 1 && b == 1 && c == 0)  q = 110;
    else if (a == 1 && b == 1 && c == 1)  q = 111;
    else                                   q = 0;
}

void move_tai()
{
    // ★ 优先级：hei > 超声波停车(stop) > zhi > 普通循迹
    if(heiLocked)
    {
        unsigned long el = millis() - heiStart;

        if(el < HEI_DURATION)
        {
#if HEI_EARLY_EXIT
            // ★ 黑线已经从探头下走掉 → 立刻收工，不用死等满 HEI_DURATION
            if(el > HEI_MIN_MS && q != 111)
            {
                heiLocked   = false;
                ultraLocked = false;
                heiArmed    = false;   // 必须重新"离开→再进入"才能再次触发
                return;                // 下一轮交给 switch(q) 正常处理
            }
#endif
            qian();
            return;
        }
        else
        {
            heiLocked   = false;
            ultraLocked = false;
            heiArmed    = false;
            ting();
            return;
        }
    }

    // ★★★ 超声波停车锁：优先级高于对正(zhi)和普通循迹
    //     （仍低于上面的 hei 黑线动作 —— 想改成"停车压过一切"的话，
    //       把这三行挪到 heiLocked 判断之前即可）
    if(stopLocked)
    {
        ting();
        return;
    }

    // ★★★ 黑线去抖 + 单次触发
    //   原来只要某一轮 loop 恰好读到 111 就立刻锁死一整个 HEI_DURATION，
    //   中间探头(D3)只要有一瞬间读成 1，就会出现"卡 3 秒"的假象。
    if(q == 111)
    {
        if(!q111Active) { q111Active = true; q111Start = millis(); }
    }
    else
    {
        q111Active = false;
        heiArmed   = true;             // 黑线离开探头，重新武装
    }

    // ★ 黑线优先级最高：可抢占正在进行的对正(zhi)
    if(heiArmed && q111Active && (millis() - q111Start >= HEI_DEBOUNCE_MS))
    {
        heiArmed  = false;             // 一次触发只认一次，必须离开过才能再触发
        zhiLocked = false;
        hei(y);
        qian();
        return;
    }

    if(zhiLocked)
    {
        // ★ 已回到线上 → 立刻恢复直行
        if(q == 10)
        {
            zhiLocked = false;
            qian();
            return;
        }

        // ★★★ 关键修正：偏离变大就立刻让位
        //   物理上 10 → 100 必然经过 110（外侧探头先压线、中间探头后离开），
        //   而 110 会锁上 zhiLocked；旧代码的这个锁不认 100，于是车会一直
        //   原地对正、直到碰巧转回 q==10 才解锁——这就是那几秒的延迟。
        bool worse = (q == 100 || q == 1 || q == 0);
        bool overtime = false;
#if ZHI_TIMEOUT_MS
        overtime = (millis() - zhiStart > ZHI_TIMEOUT_MS);
#endif

        if(worse || overtime)
        {
            zhiLocked = false;   // 解锁，落到下面的 switch 按当前 q 立即处理
        }
        else
        {
            zhi();               // 仍处于 110，继续对正
            return;
        }
    }

    switch(q)
    {
        case 10:   qian();   break;
        case 100:  L();      break;
        case 1:    R();      break;
        case 110:  zhi();    break;
        case 111:  ting();   break;   // ★ 去抖确认中 / 已触发过未重新武装 → 先停住，看清读数
        default:   ting();   break;
    }
}

void qian()
{
    analogWrite(10, 255);
    analogWrite(9, 0);
    analogWrite(6, 255);
    analogWrite(5, 0);
}

void hou()
{
    analogWrite(10, 0);
    analogWrite(9, 255);
    analogWrite(6, 0);
    analogWrite(5, 255);
}

void L()
{
    analogWrite(10, 255);
    analogWrite(9, 0);
    analogWrite(5, 255);
    analogWrite(6, 0);
}

void R()
{
    analogWrite(10, 0);
    analogWrite(9, 255);
    analogWrite(6, 255);
    analogWrite(5, 0);
}

void zhi()
{
    if(!zhiLocked) { zhiLocked = true; zhiStart = millis(); }
    analogWrite(10, 255);
    analogWrite(9, 0);
    analogWrite(6, 0);
    analogWrite(5,200 );
}

void ting()
{
    analogWrite(10, 0);
    analogWrite(9, 0);
    analogWrite(6, 0);
    analogWrite(5, 0);
}

void hei(int i)
{
    if(!heiLocked)
    {
        heiLocked = true;
        heiStart = millis();
    }
    ultraLocked = true;   // ★ 上锁：hei(y) 动作期间屏蔽超声波停车
}

// ★★★ 非阻塞超声波：不等待，分段执行
void updateUltrasonic()
{
    static unsigned long lastTrigger = 0;

    switch(ultraState)
    {
        case 0:  // 空闲 → 发送触发脉冲
            if(micros() - lastTrigger > ULTRA_INTERVAL_US)
            {
                digitalWrite(TRIGPIN, LOW);
                delayMicroseconds(2);
                digitalWrite(TRIGPIN, HIGH);
                delayMicroseconds(10);
                digitalWrite(TRIGPIN, LOW);
                trigTime = micros();
                ultraState = 1;
            }
            break;

        case 1:  // 等待回响 → 非阻塞读取
            {
                // ★ 超时 2000us：扣掉模块响应延迟后约可测到 30cm，
                //   再远的回波直接判为"无障碍"，最长阻塞 2ms，不会饿着循迹传感器
                unsigned long duration = pulseIn(ECHOPIN, HIGH, ECHO_TIMEOUT_US);
                if(duration > 0)
                {
                    distance = duration / 58.0;
                }
                else
                {
                    distance = 999;  // 超时 = 无障碍
                }
                lastTrigger = micros();
                ultraState = 0;
            }
            break;
    }
}

void STOP()
{
    // ★ 超声波状态锁生效中（hei(y) 正在执行）→ 不响应超声波停车
    if(ultraLocked)
    {
        stopLocked = false;
        return;
    }

    static int clearCnt = 0;

    if(distance <= STOP_MAX)
    {
        // ★ 测到障碍：立刻上锁 + 停车（不等待确认，安全优先）
        clearCnt   = 0;
        stopLocked = true;
        ting();
    }
    else if(stopLocked)
    {
        // ★ 已经停着了：要连续 N 次测不到才放行，防止单个丢包就往前窜
        if(++clearCnt >= STOP_CLEAR_COUNT)
        {
            stopLocked = false;
        }
    }
    else
    {
        clearCnt = 0;
    }
}

void setup()
{
    Serial.begin(115200);        // ★ 提高波特率，减少串口耗时
    Serial.setTimeout(3);        // ★ 3ms 超时

    pinMode(3, INPUT);
    pinMode(A5, INPUT);
    pinMode(A4, INPUT);
    pinMode(5, OUTPUT);
    pinMode(6, OUTPUT);
    pinMode(9, OUTPUT);
    pinMode(10, OUTPUT);
    pinMode(TRIGPIN, OUTPUT);
    pinMode(ECHOPIN, INPUT);
}

void loop()
{
    // ① 读传感器（< 1ms）
    a = digitalRead(A4);
    b = digitalRead(3);
    c = digitalRead(A5);

    // ② 串口（★ 改成非阻塞逐字节累积，不再因 readStringUntil 卡 3ms）
    static String cmd = "";
    while(Serial.available() > 0)
    {
        char ch = (char)Serial.read();
        if(ch == '\n')
        {
            cmd.trim();
            if(cmd.length() > 0)
            {
                threshold = cmd.toInt();
                y = threshold;
            }
            cmd = "";
        }
        else if(ch != '\r' && cmd.length() < 12)
        {
            cmd += ch;
        }
    }

    // ③ 超声波测量 + 停车判定（★ 提到 move_tai() 之前：
    //    这样同一轮里就能先把停车锁立起来，move_tai() 立刻让路，
    //    不会再出现"先开出去、下一轮才停"的一拍延迟）
    updateUltrasonic();
    STOP();

    // ④ 状态判断 + 执行（< 1ms）
    du();
    move_tai();

    // ⑤ 调试输出：100ms 一次，带上黑线武装状态、停车锁和超声波距离
    //    格式：a,b,c,q,zhiLocked,heiLocked,heiArmed,stopLocked,distance
    static unsigned long lastPrint = 0;
    if(millis() - lastPrint > 100)
    {
        lastPrint = millis();
        Serial.print(a);
        Serial.print(",");
        Serial.print(b);
        Serial.print(",");
        Serial.print(c);
        Serial.print(",");
        Serial.print(q);
        Serial.print(",");
        Serial.print(zhiLocked);
        Serial.print(",");
        Serial.print(heiLocked);
        Serial.print(",");
        Serial.print(heiArmed);
        Serial.print(",");
        Serial.print(stopLocked);
        Serial.print(",");
        Serial.println(distance, 1);
    }
}